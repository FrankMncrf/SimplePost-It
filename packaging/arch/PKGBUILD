# Maintainer: FrankMncrf <frank@simplepostit.invalid>
pkgname=simplepostit
pkgver=1.0.2
pkgrel=1
pkgdesc="Your pinned Simplenote notes as sticky notes on the desktop"
arch=('any')
url="https://github.com/FrankMncrf/SimplePost-It"
license=('GPL-3.0-or-later')
depends=('python' 'python-pyqt6')
optdepends=('simplenote-electron-bin: the Simplenote desktop app whose session SimplePost-It uses')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0868b83880eb97e41725aef6db4c195fb36c3405271f7601fe68de53b555d2e2')

check() {
    cd "SimplePost-It-$pkgver"
    QT_QPA_PLATFORM=offscreen make test
}

package() {
    cd "SimplePost-It-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
}
